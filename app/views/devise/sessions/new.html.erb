<div class="flex flex-col w-full items-center justify-center h-screen bg-[url('/bglogin.jpg')] bg-contain  bg-top bg-no-repeat">

  <%= simple_form_for(resource, as: resource_name, 
            html: { class: "flex flex-col 
                    px-6 py-6 gap-5 w-full lg:w-[452px]
                    items-center bg-white shadow-lg shadow-black/30
                    border border-gray-500/30 rounded-3xl" },
            url: session_path(resource_name)) do |f| %>

    <h2 class="text-2xl font-semibold">Log In</h2>
    <div class="flex flex-col w-full gap-4">
      <%= f.input :email,
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password,
                  label: "Senha",
                  required: false,
                  input_html: { autocomplete: "current-password" } %>
      <div class="flex flex-row w-full">
        <%= f.input :remember_me, label:"Mantenha Conectado", wrapper_html: {class: "text-sm whitespace-nowrap flex flex-row justify-start items-center"}, as: :boolean if devise_mapping.rememberable? %>
        <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
          <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "whitespace-nowrap text-sm hover:text-vibrant-blue" %>
        <% end %>
      </div>
    </div>

    <div class="flex flex-row items-center justify-between w-full gap-4">
      <%= f.button :submit, "Log in", class: "flex flex-col 
            items-center justify-center 
            px-4.5 py-2 rounded-lg 
            font-semibold text-white w-1/2 text-xl bg-text-primary border hover:cursor-pointer hover:bg-text-primary/70" %>
      <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
      <%= link_to "Registre-se", new_registration_path(resource_name), class: "flex flex-col 
            items-center justify-center 
            px-4.5 py-2 rounded-lg hover:bg-gray-300
            font-semibold text-xl w-1/2 border border-light-gray-2/50" %>
      <% end %>

    </div>
  <% end %>
</div>

