
<div class="absolute
            flex flex-col 
            w-full h-full top-0 left-0
            justify-center items-center
            bg-black/30 z-99">
      
<%= simple_form_for list,
    data: { turbo_stream: true },
    html: { class: "flex flex-col 
                    px-6 py-6 gap-5 w-full lg:w-[452px]
                    items-center bg-white
                    border border-gray-500/30 rounded-3xl" } do |f| %>

    <% if list.persisted?  
          title = "Editar lista"
          submitBtnText = "Confirmar"
        else
          title = "Criar Nova lista" 
          submitBtnText = "Criar Lista"
        end
    %>

  <div class="flex flex-row justify-between items-center w-full">
    <h2 class="text-xl font-bold"><%= title %></h2>
    <%= link_to close_modal_path, data: { turbo_stream: true } do %>
      <%= image_tag "close-black.svg", class: "p-0 h-5 w-5 object-fill text-black fill-black" %>
    <% end %>
  </div>

  <div class="flex flex-col justify-center items-center w-full gap-3">
    <%= f.input :title,
                placeholder: (list.errors[:title].any? ? "Campo Obrigatório" : "Insira o nome da lista"),
                label: "Nome da lista *"
                %>

    <%= f.input :description, 
                placeholder: "Insira uma breve descrição"  %>

    <% color_options = {
      "green-lemon" => "bg-green-lemon text-white",
      "vibrant-purple" => "bg-vibrant-purple text-white",
      "vibrant-blue" => "bg-vibrant-blue text-white",
      "vibrant-yellow" => "bg-vibrant-yellow text-white",
      "coral" => "bg-coral text-white",
      "black" => "bg-black text-white"
    } %>
    <fieldset class="flex flex-col w-full gap-2">
      <legend class="text-sm font-semibold">Cor</legend>
      <div class="flex gap-3">
        <% color_options.each do |value, classes| %>
          <label class="flex items-center cursor-pointer">
            <%= f.radio_button :color, value, class: "sr-only peer" %>
            <span class="h-6 w-6 rounded-full border <%= classes %> peer-checked:ring-2 peer-checked:ring-black"></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <%= hidden_field_tag :current_list_id, @current_list_id %>
  </div>

  <% if list.persisted? %>
    <div class="flex w-full justify-center">
      <% if list.active? %>
        <%= link_to "Arquivar lista", archive_list_path(list),
            data: { turbo_method: :patch },
            class: "text-sm text-light-gray hover:text-black underline hover:cursor-pointer" %>
      <% else %>
        <%= link_to "Desarquivar lista", unarchive_list_path(list),
            data: { turbo_method: :patch },
            class: "text-sm text-light-gray hover:text-black underline hover:cursor-pointer" %>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-row w-full items-center justify-between gap-2">
    <%= link_to "Cancelar",
    close_modal_path,
    data: { turbo_stream: true },
    class: "flex flex-col 
            items-center justify-center 
            px-4.5 py-2 rounded-lg hover:bg-gray-300
            font-semibold text-xl w-1/2 border border-light-gray-2/50" %>

    <%= f.submit submitBtnText, class: "flex flex-col 
            items-center justify-center 
            px-4.5 py-2 rounded-lg 
            font-semibold text-white text-xl w-1/2 bg-text-primary border hover:cursor-pointer hover:bg-text-primary/70" %>
  </div>
<% end %>
</div>
