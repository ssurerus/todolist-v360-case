<%= turbo_stream.remove "list_#{@list.id}" %>
<%= turbo_stream.update "modal_frame", "" %>

<% if @was_current %>
  <%= turbo_stream.update "navbar_title" do %>
    <%= render "lists/navbar_title", list: @list %>
  <% end %>
<% end %>

<% if current_user.lists.archived.none? %>
  <%= turbo_stream.update "archived_lists" do %>
    <%= render "lists/empty_state", status: "archived" %>
  <% end %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>
