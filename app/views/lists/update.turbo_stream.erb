<%= turbo_stream.replace "list_#{@list.id}" do %>
  <%= render partial: "lists/list", locals: { list: @list } %>
<% end %>

<% if @current_list_id == @list.id %>
  <%= turbo_stream.update "navbar_title" do %>
    <%= render "lists/navbar_title", list: @list %>
  <% end %>


<% end %>


<%= turbo_stream.update "modal_frame", "" %>
<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>
