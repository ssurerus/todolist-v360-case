<%= turbo_stream.update "list_items" do %>
  <%= render "lists/list_items" %>
<% end %>

<%= turbo_stream.replace "list_#{@list.id}" do %>
  <%= render partial: "lists/list", locals: { list: @list } %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>
