<% if notice.present? || alert.present? %>
  <div data-controller="flash">
    <% if notice.present? %>
      <div class=" mb-2 rounded bg-emerald-100 px-4 py-2 text-sm text-emerald-800 text-center"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="mb-2 rounded bg-rose-100 px-4 py-2 text-sm text-rose-800 text-center"><%= alert %></div>
    <% end %>
  </div>
<% end %>
